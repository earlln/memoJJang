<Project>
  <!--
    ============================================================
     메모짱 버전 관리 단일 출처 (Single Source of Truth)
     - VersionPrefix 만 수정하면 어셈블리/파일/제품 버전이 모두 갱신됩니다.
     - AppInfo.Version 은 이 값을 어셈블리 메타데이터에서 읽어옵니다.
     - 규칙: Semantic Versioning 2.0.0 (MAJOR.MINOR.PATCH)
     - 릴리스 절차는 docs/VERSIONING.md 참고
    ============================================================
  -->
  <PropertyGroup>
    <VersionPrefix>1.1.0</VersionPrefix>
    <!-- 사용자에게 보이는 짧은 버전 (창 제목에 사용) -->
    <DisplayVersion>1.1</DisplayVersion>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <Version>$(VersionPrefix)</Version>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <AssemblyMetadata Include="DisplayVersion" Value="$(DisplayVersion)" />
  </ItemGroup>
</Project>
