<Window x:Class="MemoJJang.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="메모짱 정보"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI, Malgun Gothic"
        FontSize="13">
    <StackPanel Margin="26,24,26,20">
        <StackPanel Orientation="Horizontal">
            <Border Width="52" Height="52"
                    CornerRadius="12"
                    Background="{DynamicResource App.Accent}">
                <TextBlock Text="메"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource App.AccentText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Margin="0,3,0,0"
                           Foreground="{DynamicResource App.TextMuted}" />
            </StackPanel>
        </StackPanel>

        <Border Margin="0,20,0,0"
                Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12">
            <StackPanel>
                <TextBlock Text="심플하면서도 세련된 윈도우 메모장."
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource App.TextMuted}"
                           Text="탭 편집 · 다크 모드 · 세션 유지 · 정밀한 인코딩 관리(자동 감지 / BOM / 줄 바꿈 형식)를 지원합니다." />
            </StackPanel>
        </Border>

        <TextBlock x:Name="RuntimeText"
                   Margin="0,14,0,0"
                   Foreground="{DynamicResource App.TextMuted}" />

        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource App.TextMuted}">
            <Run Text="제작 " /><Hyperlink x:Name="HomeLink"
                                          NavigateUri="https://earlln.com"
                                          RequestNavigate="HomeLink_RequestNavigate">Earlln.com</Hyperlink>
        </TextBlock>

        <Button Content="확인"
                IsDefault="True"
                IsCancel="True"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Style="{StaticResource App.AccentButton}" />
    </StackPanel>
</Window>
