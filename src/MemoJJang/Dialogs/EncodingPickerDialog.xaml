<Window x:Class="MemoJJang.Dialogs.EncodingPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="인코딩 선택"
        Width="520" Height="430"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI, Malgun Gothic"
        FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="DescriptionText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Foreground="{DynamicResource App.TextMuted}" />

        <ListBox x:Name="EncodingList"
                 Grid.Row="1"
                 Style="{StaticResource App.ListBox}"
                 ItemContainerStyle="{StaticResource App.ListBoxItem}"
                 DisplayMemberPath="DisplayName"
                 SelectionChanged="EncodingList_SelectionChanged" />

        <TextBlock x:Name="EncodingHintText"
                   Grid.Row="2"
                   Margin="2,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource App.TextMuted}" />

        <StackPanel x:Name="LineEndingPanel" Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="줄 바꿈 형식" Margin="2,0,0,6" />
            <ListBox x:Name="LineEndingList"
                     Height="98"
                     Style="{StaticResource App.ListBox}"
                     ItemContainerStyle="{StaticResource App.ListBoxItem}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="확인" IsDefault="True"
                    Style="{StaticResource App.AccentButton}" Click="Ok_Click" />
            <Button Content="취소" IsCancel="True" Margin="8,0,0,0"
                    Style="{StaticResource App.Button}" />
        </StackPanel>
    </Grid>
</Window>
