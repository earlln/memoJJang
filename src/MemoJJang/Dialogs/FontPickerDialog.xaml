<Window x:Class="MemoJJang.Dialogs.FontPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="글꼴"
        Width="640" Height="500"
        MinWidth="560" MinHeight="440"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI, Malgun Gothic"
        FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="글꼴" Margin="2,0,0,6" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="스타일" Margin="12,0,0,6" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="크기" Margin="12,0,0,6" />

        <DockPanel Grid.Row="1" Grid.Column="0">
            <TextBox x:Name="FilterBox"
                     DockPanel.Dock="Top"
                     Margin="0,0,0,6"
                     Style="{StaticResource App.TextBox}"
                     TextChanged="FilterBox_TextChanged" />
            <ListBox x:Name="FamilyList"
                     Style="{StaticResource App.ListBox}"
                     ItemContainerStyle="{StaticResource App.ListBoxItem}"
                     SelectionChanged="Selection_Changed" />
        </DockPanel>

        <ListBox x:Name="StyleList"
                 Grid.Row="1" Grid.Column="1"
                 Margin="12,0,0,0"
                 Style="{StaticResource App.ListBox}"
                 ItemContainerStyle="{StaticResource App.ListBoxItem}"
                 SelectionChanged="Selection_Changed" />

        <ListBox x:Name="SizeList"
                 Grid.Row="1" Grid.Column="2"
                 Margin="12,0,0,0"
                 Style="{StaticResource App.ListBox}"
                 ItemContainerStyle="{StaticResource App.ListBoxItem}"
                 SelectionChanged="Selection_Changed" />

        <Border Grid.Row="2" Grid.ColumnSpan="3"
                Margin="0,14,0,0"
                Height="86"
                Background="{DynamicResource App.Editor.Background}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                CornerRadius="8">
            <TextBlock x:Name="PreviewText"
                       Text="메모짱 AaBbGg 123 다람쥐 헌 쳇바퀴에 타고파"
                       Foreground="{DynamicResource App.Editor.Foreground}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="확인" IsDefault="True"
                    Style="{StaticResource App.AccentButton}" Click="Ok_Click" />
            <Button Content="취소" IsCancel="True" Margin="8,0,0,0"
                    Style="{StaticResource App.Button}" />
        </StackPanel>
    </Grid>
</Window>
