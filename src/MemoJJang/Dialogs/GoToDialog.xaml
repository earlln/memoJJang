<Window x:Class="MemoJJang.Dialogs.GoToDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="줄 이동"
        Width="340"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI, Malgun Gothic"
        FontSize="13">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" Text="줄 번호:" Margin="0,0,0,8" />
        <TextBox x:Name="LineNumberBox"
                 Style="{StaticResource App.TextBox}"
                 KeyDown="LineNumberBox_KeyDown" />
        <TextBlock x:Name="HintText"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource App.TextMuted}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="이동" IsDefault="True" Style="{StaticResource App.AccentButton}" Click="Ok_Click" />
            <Button Content="취소" IsCancel="True" Margin="8,0,0,0" Style="{StaticResource App.Button}" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
