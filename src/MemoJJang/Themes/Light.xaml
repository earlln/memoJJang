<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 메모짱 라이트 테마 팔레트 -->
    <SolidColorBrush x:Key="App.Background"        Color="#FFFAFAFB" />
    <SolidColorBrush x:Key="App.Surface"           Color="#FFF3F3F5" />
    <SolidColorBrush x:Key="App.SurfaceAlt"        Color="#FFE9E9ED" />
    <SolidColorBrush x:Key="App.Menu.Background"   Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="App.Border"            Color="#FFDDDDE3" />
    <SolidColorBrush x:Key="App.Text"              Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="App.TextMuted"         Color="#FF6A6A75" />
    <SolidColorBrush x:Key="App.Accent"            Color="#FF2F6FED" />
    <SolidColorBrush x:Key="App.AccentText"        Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="App.Hover"             Color="#FFE6E6EA" />
    <SolidColorBrush x:Key="App.Pressed"           Color="#FFD9D9DF" />
    <SolidColorBrush x:Key="App.Selection"         Color="#FFB9D4FF" />
    <SolidColorBrush x:Key="App.Editor.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="App.Editor.Foreground" Color="#FF17171A" />
    <SolidColorBrush x:Key="App.Caret"             Color="#FF17171A" />
    <SolidColorBrush x:Key="App.Tab.Selected"      Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="App.Tab.Unselected"    Color="#00000000" />
    <SolidColorBrush x:Key="App.Warning"           Color="#FFB25000" />

</ResourceDictionary>
